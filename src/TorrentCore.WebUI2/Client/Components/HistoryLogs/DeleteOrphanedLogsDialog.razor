@namespace TorrentCore.WebUI2.Client.Components.HistoryLogs

<MudDialog>
    <DialogContent>
        <p>Delete log entries associated with torrents that no longer have a current or historical torrent record? Other service logs are kept.</p>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="Confirm">Delete Orphaned Logs</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    private void Confirm() => Dialog.Close(DialogResult.Ok(true));
    private void Cancel() => Dialog.Cancel();
}
