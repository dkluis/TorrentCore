@namespace TorrentCore.WebUI2.Client.Components.Torrents

<MudDialog>
    <DialogContent><p>@Message</p></DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="Confirm">@ConfirmText</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Parameter] public string Message { get; set; } = string.Empty;
    [Parameter] public string ConfirmText { get; set; } = "Confirm";
    private void Confirm() => Dialog.Close(DialogResult.Ok(true));
    private void Cancel() => Dialog.Cancel();
}
