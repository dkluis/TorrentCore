<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <LangVersion>14</LangVersion>
    <Version>0.7.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TorrentCore.Client\TorrentCore.Client.csproj" />
    <ProjectReference Include="..\TorrentCore.Contracts\TorrentCore.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="8.15.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Config/service-connection.json" />
    <None Remove="Config/service-connection.json" />
  </ItemGroup>

  <Target Name="CopyMacOSAppDeploymentResources" AfterTargets="Publish">
    <ItemGroup>
      <MacOSAppDeploymentResource Include="Deployment/**/*" />
    </ItemGroup>
    <Copy
      SourceFiles="@(MacOSAppDeploymentResource)"
      DestinationFiles="@(MacOSAppDeploymentResource->'$(PublishDir)TorrentCoreWebUI.Deployment/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Error
      Condition="Exists('$(PublishDir)Config/service-connection.json')"
      Text="Machine-local Config/service-connection.json must not be present in WebUI publish output." />
  </Target>

</Project>
