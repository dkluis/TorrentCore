{
  "TorrentCoreService": {
    "BaseUrl": "http://127.0.0.1:7033/"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": false,
        "TimestampFormat": "yyyy-MM-ddTHH:mm:ss.fffK ",
        "UseUtcTimestamp": true
      }
    }
  },
  "AllowedHosts": "*"
}
